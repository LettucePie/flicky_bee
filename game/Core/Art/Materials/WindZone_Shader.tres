code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled;

instance uniform vec2 UVScale = vec2(1.000000, 1.000000);
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_5;
instance uniform vec3 Darken = vec3(1.000000, 1.000000, 1.000000);



void fragment() {
// Vector2Parameter:8
	vec2 n_out8p0 = UVScale;


// UVFunc:7
	vec2 n_in7p2 = vec2(0.00000, 0.00000);
	vec2 n_out7p0 = (UV - n_in7p2) * n_out8p0 + n_in7p2;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out7p0);


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, UV);


// VectorOp:6
	vec4 n_out6p0 = n_out2p0 - n_out5p0;


// Vector3Parameter:10
	vec3 n_out10p0 = Darken;


// ColorOp:9
	vec3 n_out9p0 = min(vec3(n_out6p0.xyz), n_out10p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out9p0.x;


}
"
